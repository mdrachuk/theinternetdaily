# Copy this file to `.env` and fill in. Docker Compose reads .env
# automatically and never logs its contents.

# LLM backend: "anthropic" (default), "vllm" (local GPU), or "ollama" (local CPU)
LLM_BACKEND=anthropic

# Required when LLM_BACKEND=anthropic. Create a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- LLM_BACKEND=vllm ----------------------------------------------------
# Bring the server up with:
#   docker compose -f docker-compose.yml -f docker-compose.vllm.yml up
# google/gemma-3-12b-it is gated: accept the licence on its Hugging Face model
# page and paste a read token here. The ~25 GB download is cached in ./data/hf.
# HF_TOKEN=hf_...
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=google/gemma-3-12b-it
# VLLM_QUANTIZATION=fp8           # compressed-tensors for a pre-quantized (QAT) checkpoint
# HF_CACHE=/root/.cache/huggingface   # reuse an existing HF cache instead of ./data/hf
# VLLM_MAX_MODEL_LEN=16384        # 20 GB card: FP8 weights ~12 GB, KV cache ~6 GB
# VLLM_MAX_NUM_SEQS=4             # server-side concurrency; the app matches it
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_TIMEOUT=1800               # a 12B model at 70 W is slow
# VLLM_PORT=8001                  # host port, for benchmarking

# --- LLM_BACKEND=ollama --------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# Storage backend. Default: SQLite at PAPERNEWS_STATE (no extra services).
# Set a URL to switch — needs the matching extra (papernews[mongo]).
# PAPERNEWS_STORE=mongodb://mongo:27017/papernews
#
# Job queue. Default: in-process asyncio. Set a Redis URL to run jobs in
# separate arq worker processes (papernews[redis]) — that is what actually
# bounds LLM concurrency across processes.
# PAPERNEWS_QUEUE=redis://redis:6379
# PAPERNEWS_MAX_JOBS=1              # worker-side cap; match your LLM concurrency

# Optional overrides
# PAPERNEWS_WORKERS=4             # concurrent LLM batches; unset = the backend's own cap
# OLLAMA_TIMEOUT=1800             # httpx timeout in seconds for Ollama requests (default 1800)

# Scheduling — pick one:
# INGEST_INTERVAL_SECONDS=14400   # every N seconds (default 4h)
# INGEST_SCHEDULE=07:00,18:00     # cron-style fixed times (overrides the interval)
# INGEST_TIMEZONE=Europe/London   # IANA tz, used with INGEST_SCHEDULE (default UTC)

# Bind address for the published port. Default 0.0.0.0 (reachable on the LAN);
# set to 127.0.0.1 when a reverse proxy on the host is the only way in, so the
# container itself is not exposed.
# PAPERNEWS_BIND=127.0.0.1

# Post-ingest delivery hook (e.g. push the new PDF to a reMarkable).
# Drop the script in ./data/hooks/ and point this at it:
# POST_INGEST_HOOK=/data/hooks/push-to-remarkable.sh
# POST_INGEST_HOOK_TIMEOUT=300
